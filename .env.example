# ---------------------------------------------------------------------------
# Contact form delivery (Resend — https://resend.com)
# ---------------------------------------------------------------------------
# 1. Create an API key at https://resend.com/api-keys
# 2. Verify the sending domain (itlogica.com) at https://resend.com/domains
# 3. Copy this file to `.env.local` and fill in the values below.
#
# Without RESEND_API_KEY the API route still validates and accepts submissions,
# logs them to the server console, and returns success — so the site never
# breaks in local development.
# ---------------------------------------------------------------------------

RESEND_API_KEY=

# Verified sender on your Resend domain.
CONTACT_FROM_EMAIL="ITLogica Website <website@itlogica.com>"

# Office routing. Overrides the defaults in src/data/site.ts if set.
CONTACT_EMAIL_ATLANTA=yhanam@itlogica.com
CONTACT_EMAIL_NANJING=jay.fang@itlogica.com

# Optional: BCC every submission to a shared inbox.
CONTACT_BCC_EMAIL=
